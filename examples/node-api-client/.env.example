# Avatar API v1 — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then load before running:
#   source .env && node client.mjs
#
# Or pass inline:
#   AVTR_API_KEY=your_key node client.mjs

# Required: Your API key (starts with avtr_test_ or avtr_live_)
AVTR_API_KEY=

# Optional: Override the base URL (defaults to production)
# AVTR_API_BASE=https://avatar-session-bridge.vallangirakesh.workers.dev
